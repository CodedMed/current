# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000
# Public origin the browser uses. In development this is the Vite dev server,
# which proxies /api to the Express backend. OAuth redirect URIs derive from it.
APP_URL=http://localhost:5173
# Random string used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── Google sign-in (OAuth 2.0 / OpenID Connect) ───────────────────────────
# Create a "Web application" OAuth client in Google Cloud Console and add
#   <APP_URL>/api/auth/google/callback
# as an authorized redirect URI. Leave blank to run sign-in in sandbox mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Persona identity verification (KYC / AML) ─────────────────────────────
# Sandbox keys start with persona_sandbox_ and never incur charges.
PERSONA_API_KEY=
# The inquiry template to run (starts with itmpl_). Use your KYC/AML template.
PERSONA_TEMPLATE_ID=
# Optional. Enables signature verification for POST /api/identity/webhook.
PERSONA_WEBHOOK_SECRET=
# Persona REST API version header.
PERSONA_API_VERSION=2025-12-08
# When a template has no automated decision step, inquiries settle at
# "completed" instead of "approved". Set to false to require "approved".
PERSONA_ACCEPT_COMPLETED=true

# ─── Nessie (Capital One hackathon banking API) ─────────────────────────────
# Get a key at http://api.nessieisreal.com. Leave blank to use the in-memory
# fixture implementation of the same API.
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com
# Where the cash-flow dashboard reads from: "nessie" (your provisioned Nessie
# workspace, live or in-memory) or "mock" (the generated sample ledger).
CASHFLOW_SOURCE=nessie

# ─── Cash Flow Copilot backend (Java ledger + Python intelligence) ──────────
# Express is the BFF for both services; the browser never reaches them. Every
# value below is optional in development: the services fall back to mock
# adapters, the ledger starts an embedded PostgreSQL, and DEMO_MODE seeds the
# demo business for each verified user. Keep the same token in all three .env
# files (or start the services from this one, see README).
DEMO_MODE=true
INTERNAL_SERVICE_TOKEN=local-dev-internal-token
LEDGER_SERVICE_URL=http://localhost:8080
INTELLIGENCE_SERVICE_URL=http://localhost:8000

# ─── Ledger service (Java) ──────────────────────────────────────────────────
# Tiger Data / TimescaleDB or plain PostgreSQL. Leave empty in demo mode to run
# against a throwaway embedded PostgreSQL (data is discarded on shutdown).
#   postgresql://copilot:copilot@localhost:5432/copilot
DATABASE_URL=
LEDGER_SERVICE_PORT=8080

# ─── Intelligence service (Python) ──────────────────────────────────────────
# Local document extraction through Ollama. Leave OLLAMA_MODEL empty to use
# deterministic sample values (clearly labelled in the response warnings).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
# Gemini CFO advisor (/advisor). Without a key the deterministic demo advisor answers from the
# same ledger context; in DEMO_MODE it also answers whenever Gemini is unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# ElevenLabs voice advisor. Both values are required; without them /advisor reports voice as
# unavailable and stays on text. The agent must expose a client tool named
# ask_cash_flow_advisor with a `question` parameter (see README → ElevenLabs setup).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
