{
  "name": "cashflow-onboarding",
  "version": "1.0.0",
  "description": "Keel — sign-up, identity verification, and onboarding flow for small-business cash-flow management",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "dependencies": {
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.0.2",
    "lucide-react": "^1.45.0",
    "persona": "^5.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
