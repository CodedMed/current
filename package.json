{
  "name": "cashflow-onboarding",
  "version": "1.0.0",
  "description": "Keel — sign-up, identity verification, onboarding, and the Cash Flow Copilot backend (ledger, documents, invoice risk, advisor) for small-business cash-flow management",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.ts",
    "dev:client": "vite",
    "dev:ledger": "cd services/ledger-service && node ../../scripts/with-env.mjs ./mvnw -q spring-boot:run",
    "dev:intelligence": "cd services/intelligence-service && node ../../scripts/with-env.mjs sh -c '.venv/bin/uvicorn app.main:app --reload --port \"${INTELLIGENCE_SERVICE_PORT:-8000}\"'",
    "dev:services": "concurrently -k -n ledger,intel -c yellow,green \"npm:dev:ledger\" \"npm:dev:intelligence\"",
    "dev:all": "concurrently -k -n server,client,ledger,intel -c blue,magenta,yellow,green \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:ledger\" \"npm:dev:intelligence\"",
    "setup:intelligence": "cd services/intelligence-service && python3 -m venv .venv && .venv/bin/pip install -q --upgrade pip && .venv/bin/pip install -q -e '.[documents,ml,ai,dev]'",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "test": "node --env-file-if-exists=.env --test \"server/**/*.test.ts\" \"client/src/**/*.test.ts\" \"shared/**/*.test.ts\"",
    "test:ledger": "cd services/ledger-service && NESSIE_API_KEY= DATABASE_URL= node ../../scripts/with-env.mjs ./mvnw -q test",
    "test:intelligence": "cd services/intelligence-service && .venv/bin/pytest -q",
    "test:all": "npm test && npm run test:intelligence && npm run test:ledger"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "dependencies": {
    "@elevenlabs/client": "^1.25.0",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.0.2",
    "lucide-react": "^1.45.0",
    "persona": "^5.8.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
